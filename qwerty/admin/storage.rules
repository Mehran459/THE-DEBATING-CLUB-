rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function mainAdmin() {
      return activeAdmin()
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'main';
    }

    match /club-media/{ownerUid}/{fileName} {
      // Club photos are intentionally public when referenced by public content.
      allow read: if true;
      allow create, update: if activeAdmin()
        && (request.auth.uid == ownerUid || mainAdmin())
        && request.resource != null
        && request.resource.size < 14 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp|avif)');
      allow delete: if activeAdmin() && (request.auth.uid == ownerUid || mainAdmin());
    }
  }
}
