rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function activeAdmin() {
      return signedIn()
        && exists(adminPath())
        && get(adminPath()).data.active == true;
    }

    function mainAdmin() {
      return activeAdmin() && get(adminPath()).data.role == 'main';
    }

    function ownsNewDocument() {
      return activeAdmin() && request.resource.data.createdBy == request.auth.uid;
    }

    function ownsExistingDocument() {
      return activeAdmin() && resource.data.createdBy == request.auth.uid;
    }

    function ownerCanUpdateDocument() {
      return ownsExistingDocument()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'body', 'date', 'venue', 'type', 'url', 'storagePath', 'published', 'updatedAt'
        ]);
    }

    function validAdminProfile() {
      return request.resource.data.keys().hasOnly([
          'name', 'email', 'role', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.role in ['president', 'gs']
        && request.resource.data.active is bool;
    }

    function validContentFields() {
      return request.resource.data.keys().hasOnly([
          'title', 'body', 'date', 'venue', 'type', 'url', 'storagePath',
          'published', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.published is bool
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() <= 128
        && (!request.resource.data.keys().hasAny(['body'])
          || (request.resource.data.body is string && request.resource.data.body.size() <= 10000))
        && (!request.resource.data.keys().hasAny(['venue'])
          || (request.resource.data.venue is string && request.resource.data.venue.size() <= 200))
        && (!request.resource.data.keys().hasAny(['date'])
          || (request.resource.data.date is string && request.resource.data.date.size() <= 40))
        && (!request.resource.data.keys().hasAny(['url'])
          || (request.resource.data.url is string
            && request.resource.data.url.size() > 0
            && request.resource.data.url.size() <= 2048
            && request.resource.data.url.matches('https://.*')))
        && (!request.resource.data.keys().hasAny(['type'])
          || request.resource.data.type in ['Photo', 'Video link'])
        && (!request.resource.data.keys().hasAny(['storagePath'])
          || (request.resource.data.storagePath is string && request.resource.data.storagePath.size() <= 512));
    }

    // Admin profiles are private. Bootstrap the first Main Admin manually.
    match /admins/{uid} {
      allow get: if activeAdmin() && (request.auth.uid == uid || mainAdmin());
      allow list: if mainAdmin();

      // Dashboard-created accounts can only receive non-privileged roles.
      allow create: if mainAdmin() && uid != request.auth.uid && validAdminProfile();
      allow update: if mainAdmin() && uid != request.auth.uid
        && resource.data.role != 'main' && validAdminProfile();

      // Main Admin may update only their own display name, never their role/access.
      allow update: if mainAdmin() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow delete: if mainAdmin() && uid != request.auth.uid && resource.data.role != 'main';
    }

    // Public visitors can read only published content; active admins can manage drafts.
    match /announcements/{id} {
      allow get, list: if resource.data.published == true || activeAdmin();
      allow create: if ownsNewDocument() && validContentFields()
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 10000;
      allow update: if validContentFields() && (mainAdmin()
        || ownerCanUpdateDocument());
      allow delete: if mainAdmin() || ownsExistingDocument();
    }

    match /events/{id} {
      allow get, list: if resource.data.published == true || activeAdmin();
      allow create: if ownsNewDocument() && validContentFields()
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 40;
      allow update: if validContentFields() && (mainAdmin()
        || ownerCanUpdateDocument());
      allow delete: if mainAdmin() || ownsExistingDocument();
    }

    match /gallery/{id} {
      allow get, list: if resource.data.published == true || activeAdmin();
      allow create: if ownsNewDocument() && validContentFields()
        && request.resource.data.type in ['Photo', 'Video link']
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048;
      allow update: if validContentFields() && (mainAdmin()
        || ownerCanUpdateDocument());
      allow delete: if mainAdmin() || ownsExistingDocument();
    }

    // Cabinet documents are public. Never put private contact/student data here.
    match /cabinet/{id} {
      allow get, list: if resource.data.status in ['Current', 'Alumni'] || activeAdmin();
      allow create, update: if mainAdmin()
        && request.resource.data.status in ['Current', 'Alumni']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.role is string
        && request.resource.data.role.size() <= 120
        && (!request.resource.data.keys().hasAny(['photoURL'])
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2048
            && request.resource.data.photoURL.matches('https://.*')));
      allow delete: if mainAdmin();
    }

    match /activityLogs/{id} {
      allow read: if mainAdmin();
      allow create: if activeAdmin()
        && request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'action', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 300;
      allow update, delete: if false;
    }
  }
}
